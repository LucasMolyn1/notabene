{
  "name": "notabene",
  "version": "2.0.0",
  "description": "Wiki collaboratif auto-hébergé : OIDC, API REST, diagrammes et recherche IA.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/copy-assets.mjs && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "backup": "node dist/server/backup.js backup",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "marked": "^18.1.2",
    "openid-client": "^6.8.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@plantuml/core": "^1.2026.9",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-typography": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "mermaid": "^12.2.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@^3": "3.3.20",
    "nanoid@^4": "5.1.16",
    "katex@<0.18.2": "0.18.10"
  }
}
