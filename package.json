{
  "name": "notabene",
  "version": "3.6.0",
  "description": "Wiki collaboratif auto-hébergé : OIDC, API REST, diagrammes et recherche IA.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/copy-assets.mjs && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "backup": "node dist/server/backup.js backup",
    "create-admin": "node dist/server/cli.js create-admin",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "lint:install": "npm ci --prefix tools/lint",
    "lint": "tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.mjs .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@node-saml/node-saml": "^5.2.0",
    "age-encryption": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "ldapts": "^9.2.0",
    "lib0": "^0.2.119",
    "marked": "^18.1.2",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.8",
    "undici": "^8.12.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@plantuml/core": "^1.2026.9",
    "@playwright/test": "^1.64.1",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-code-block": "^3.32.1",
    "@tiptap/extension-collaboration": "^3.32.1",
    "@tiptap/extension-collaboration-caret": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-typography": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/y-tiptap": "^3.0.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "emojibase-data": "^18.0.0",
    "mermaid": "^12.2.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "y-websocket": "^3.1.0"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@^3": "3.3.20",
    "nanoid@^4": "5.1.16",
    "katex": "0.18.10"
  }
}
