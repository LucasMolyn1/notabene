# Développement local : `cp .env.development.example .env` puis `npm run dev`.
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
LOG_LEVEL=info
# Connexion sans fournisseur d'identité (refusée par le serveur si NODE_ENV=production).
DEV_LOGIN=true
# Remplacez par une vraie clé : openssl rand -base64 32
ENCRYPTION_KEY=
SEED_DEMO=true
# Optionnel : docker run -p 8081:8080 jgraph/drawio:32.6.1
DRAWIO_URL=http://localhost:8081
