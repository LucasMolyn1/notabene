# ---------------------------------------------------------------------------
# Notabene — configuration d'un déploiement (copiez en .env, ou lancez scripts/setup.sh)
# ---------------------------------------------------------------------------

# URL publique, sans / final. Sert aux cookies, à la redirection OIDC et au contrôle d'origine.
PUBLIC_URL=https://wiki.example.com
NODE_ENV=production
LOG_LEVEL=info
# true si un reverse proxy (Traefik, Nginx, Caddy…) est devant l'application.
TRUST_PROXY=true

# Clé maîtresse (32 octets base64) qui chiffre les secrets en base (clé d'API du LLM).
# Générez-la avec : openssl rand -base64 32 — et sauvegardez-la : sans elle, la clé LLM est perdue.
ENCRYPTION_KEY=

# --- OIDC (Authentik) ---------------------------------------------------------
# Issuer = URL « OpenID Configuration Issuer » du fournisseur, avec le / final.
OIDC_ISSUER=https://auth.example.com/application/o/notabene/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Groupes Authentik → rôles Notabene.
OIDC_ADMIN_GROUPS=notabene-admins
OIDC_EDITOR_GROUPS=notabene-editors
OIDC_READER_GROUPS=notabene-readers
# Utilisateur authentifié hors de ces groupes : « none » refuse l'accès, « reader » lui donne la lecture.
OIDC_DEFAULT_ROLE=none
SESSION_TTL_HOURS=12
# Fermeture d'une session sans activité (minutes, défaut 120)
# SESSION_IDLE_MINUTES=120
# Documentation interactive de l'API : auth (connectés, défaut), public ou off
# API_DOCS=auth

# --- Intégrations ---------------------------------------------------------------
# URL publique de l'instance Draw.io (service « drawio » du compose, derrière votre proxy). Vide = désactivé.
DRAWIO_URL=https://drawio.example.com
# Sites autorisés à intégrer Notabene en iframe (votre portfolio), séparés par des virgules.
EMBED_ALLOWED_ORIGINS=https://portfolio.example.com
# Crée un contenu de démonstration au premier démarrage.
SEED_DEMO=true

# --- Docker Compose ---------------------------------------------------------------
# Nom unique par déploiement (permet plusieurs instances sur la même machine).
COMPOSE_PROJECT_NAME=notabene
# « drawio » démarre le conteneur Draw.io ; videz pour le désactiver.
COMPOSE_PROFILES=drawio
NOTABENE_BIND=127.0.0.1
NOTABENE_PORT=3000
DRAWIO_BIND=127.0.0.1
DRAWIO_PORT=8081

# Comptes locaux (e-mail + mot de passe, MFA TOTP) : alternative ou complément à OIDC
# AUTH_LOCAL=true
# Imposer la double authentification (comptes locaux : TOTP ; OIDC : claim amr)
# LOCAL_REQUIRE_MFA=true
# OIDC_REQUIRE_MFA=true

# LDAP / Active Directory (voir README)
# LDAP_URL=ldaps://ad.example.org
# LDAP_BIND_DN=CN=svc-notabene,OU=Services,DC=example,DC=org
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=DC=example,DC=org
# LDAP_ADMIN_GROUPS=wiki-admins
# LDAP_EDITOR_GROUPS=wiki-editors

# SAML 2.0 (voir README)
# SAML_ENTRY_POINT=https://idp.example.org/saml/sso
# SAML_IDP_CERT_FILE=/data/idp-cert.pem
# SAML_ADMIN_GROUPS=wiki-admins

# Co-édition temps réel (WebSocket Yjs) ; false pour revenir à l'enregistrement classique
# COLLAB_ENABLED=true

# Fige la configuration (fournisseurs, SMTP, sites autorisés) dans l'environnement : l'interface devient en lecture seule
# AI_ALLOW_PRIVATE=false   # true : le fournisseur IA peut viser le réseau interne (Ollama, LM Studio). Webhooks : WEBHOOK_ALLOW_PRIVATE.
# CONFIG_LOCKED=false

# E-mail (mot de passe oublié, invitations, alertes) ; réglable aussi dans Paramètres > E-mail
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_MODE=starttls
# SMTP_USER=notabene
# SMTP_PASSWORD=
# SMTP_FROM=Notabene <wiki@example.org>

# Sauvegardes chiffrées (age) : clé publique (voir `backup.js keygen`) ; obligatoire en production sauf BACKUP_ALLOW_PLAINTEXT=true
# BACKUP_AGE_RECIPIENT=age1...

# Tentatives de connexion par minute et par adresse IP (défaut 10)
# AUTH_RATE_LIMIT_PER_MINUTE=10
