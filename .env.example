# ---------------------------------------------------------------------------
# Notabene — configuration d'un déploiement (copiez en .env, ou lancez scripts/setup.sh)
# ---------------------------------------------------------------------------

# URL publique, sans / final. Sert aux cookies, à la redirection OIDC et au contrôle d'origine.
PUBLIC_URL=https://wiki.example.com
NODE_ENV=production
LOG_LEVEL=info
# true si un reverse proxy (Traefik, Nginx, Caddy…) est devant l'application.
TRUST_PROXY=true

# Clé maîtresse (32 octets base64) qui chiffre les secrets en base (clé d'API du LLM).
# Générez-la avec : openssl rand -base64 32 — et sauvegardez-la : sans elle, la clé LLM est perdue.
ENCRYPTION_KEY=

# --- OIDC (Authentik) ---------------------------------------------------------
# Issuer = URL « OpenID Configuration Issuer » du fournisseur, avec le / final.
OIDC_ISSUER=https://auth.example.com/application/o/notabene/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Groupes Authentik → rôles Notabene.
OIDC_ADMIN_GROUPS=notabene-admins
OIDC_EDITOR_GROUPS=notabene-editors
OIDC_READER_GROUPS=notabene-readers
# Utilisateur authentifié hors de ces groupes : « none » refuse l'accès, « reader » lui donne la lecture.
OIDC_DEFAULT_ROLE=none
SESSION_TTL_HOURS=12

# --- Intégrations ---------------------------------------------------------------
# URL publique de l'instance Draw.io (service « drawio » du compose, derrière votre proxy). Vide = désactivé.
DRAWIO_URL=https://drawio.example.com
# Sites autorisés à intégrer Notabene en iframe (votre portfolio), séparés par des virgules.
EMBED_ALLOWED_ORIGINS=https://portfolio.example.com
# Crée un contenu de démonstration au premier démarrage.
SEED_DEMO=true

# --- Docker Compose ---------------------------------------------------------------
# Nom unique par déploiement (permet plusieurs instances sur la même machine).
COMPOSE_PROJECT_NAME=notabene
# « drawio » démarre le conteneur Draw.io ; videz pour le désactiver.
COMPOSE_PROFILES=drawio
NOTABENE_BIND=127.0.0.1
NOTABENE_PORT=3000
DRAWIO_BIND=127.0.0.1
DRAWIO_PORT=8081
